{{ header }}
<div class="container pn-category">
  <p class="pn-kicker">Product use · not a store category</p>
  <h1>{{ heading }}</h1>
  <p class="pn-lead">{{ kicker }}. Matched with: {{ keywords }}</p>
  {% if products %}
    <div class="pn-shelf">
      {% for product in products %}
        <a class="pn-shelf-card" href="{{ product.href }}">
          {% if product.thumb %}<img src="{{ product.thumb }}" alt="{{ product.name }}">{% endif %}
          <span class="pn-kicker">{{ product.model }}</span>
          <strong>{{ product.name }}</strong>
          <em>{{ product.price }}</em>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p>No live products matched these keywords yet. Edit them under Extensions → Themes → BeFree OpenCart Theme.</p>
    <a class="pn-btn" href="{{ contact }}">Contact the store</a>
  {% endif %}
</div>
{{ footer }}
