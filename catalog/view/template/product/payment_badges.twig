{# BeFree payment badges under Add to Cart.
   Flip the two flags to true ONLY after Apple Pay / Google Pay are enabled
   in PayPal Checkout (domain registration). Do not change payment settings
   from this template. #}
{% set bf_show_apple_pay = false %}
{% set bf_show_google_pay = false %}
{% if bf_show_apple_pay and bf_show_google_pay %}
  {% set bf_pay_note = 'Cards, Venmo, Pay Later, Apple Pay & Google Pay — all through PayPal Checkout. No PayPal account needed.' %}
{% elseif bf_show_apple_pay %}
  {% set bf_pay_note = 'Cards, Venmo, Pay Later & Apple Pay — all through PayPal Checkout. No PayPal account needed.' %}
{% elseif bf_show_google_pay %}
  {% set bf_pay_note = 'Cards, Venmo, Pay Later & Google Pay — all through PayPal Checkout. No PayPal account needed.' %}
{% else %}
  {% set bf_pay_note = 'Cards, Venmo & Pay Later — all through PayPal Checkout. No PayPal account needed.' %}
{% endif %}
<div class="bf-pay-badges{% if bf_show_apple_pay %} is-apple-pay-on{% endif %}{% if bf_show_google_pay %} is-google-pay-on{% endif %}" role="region" aria-label="All payments processed by PayPal Checkout">
  <p class="bf-pay-badges__header">
    <img class="bf-pay-badges__header-logo" src="extension/befree/catalog/view/image/payment-badges/paypal.svg" alt="" width="88" height="28"/>
    <span class="bf-pay-badges__header-title">ALL PAYMENTS PROCESSED BY PAYPAL</span>
  </p>
  <ul class="bf-pay-badges__list">
    <li class="bf-pay-badges__item"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/paypal.svg" alt="PayPal" width="110" height="32" loading="lazy"/></li>
    <li class="bf-pay-badges__item"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/paylater.svg" alt="Pay Later" width="134" height="32" loading="lazy"/></li>
    <li class="bf-pay-badges__item"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/venmo-badge.svg" alt="Venmo" width="112" height="32" loading="lazy"/></li>
    <li class="bf-pay-badges__item"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/visa.svg" alt="Visa" width="110" height="32" loading="lazy"/></li>
    <li class="bf-pay-badges__item"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/mastercard.svg" alt="Mastercard" width="110" height="32" loading="lazy"/></li>
    <li class="bf-pay-badges__item"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/amex.svg" alt="American Express" width="110" height="32" loading="lazy"/></li>
    <li class="bf-pay-badges__item"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/discover.svg" alt="Discover" width="110" height="32" loading="lazy"/></li>
    <li class="bf-pay-badges__item bf-pay-badge--applepay"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/applepay-badge.svg" alt="Apple Pay" width="134" height="32" loading="lazy"/></li>
    <li class="bf-pay-badges__item bf-pay-badge--googlepay"><img class="bf-pay-badges__mark" src="extension/befree/catalog/view/image/payment-badges/googlepay-badge.svg" alt="Google Pay" width="150" height="32" loading="lazy"/></li>
  </ul>
  <p class="bf-pay-badges__note">{{ bf_pay_note }}</p>
</div>
